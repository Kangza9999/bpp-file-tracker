<!DOCTYPE html>
<html lang="th">
<head>

<meta charset="UTF-8">
<meta name="viewport"
content="width=device-width, initial-scale=1.0">

<title>BPP Smart Workflow</title>

<script src="https://cdn.tailwindcss.com"></script>

<link rel="stylesheet"
href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">

<script src="https://unpkg.com/html5-qrcode"></script>

<script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>

<style>

body{
  background:#f3f6f4;
  font-family:'Sarabun',sans-serif;
}

.main-green{
  background:#143f24;
}

.gold{
  color:#c5a059;
}

.card{
  background:white;
  border-radius:20px;
  box-shadow:0 2px 12px rgba(0,0,0,.08);
}

.bottom-nav{
  position:fixed;
  bottom:0;
  left:0;
  right:0;
  background:white;
  border-top:1px solid #ddd;
}

.tab{
  display:none;
}

.tab.active{
  display:block;
}

.workflow-btn{
  border-radius:18px;
  padding:18px;
  font-weight:bold;
  width:100%;
  text-align:left;
}

.timeline{
  border-left:3px solid #143f24;
  padding-left:18px;
}

</style>

</head>

<body>

<!-- HEADER -->
<header class="main-green text-white p-5">

  <div class="flex items-center gap-3">

    <div class="bg-[#c5a059]
    text-black p-3 rounded-full">

      <i class="fa-solid
      fa-shield-halved"></i>

    </div>

    <div>

      <h1 class="font-bold text-xl">
        🇹🇭 BPP SMART WORKFLOW
      </h1>

      <p class="text-xs text-gray-300">
        ระบบบัญชาการติดตามแฟ้มงานอัจฉริยะ
      </p>

    </div>

  </div>

</header>

<!-- MAIN -->
<main class="p-4 pb-28">

  <!-- DASHBOARD -->
  <section id="dashboard"
  class="tab active">

    <div class="grid
    grid-cols-2 gap-3">

      <div class="card p-4
      border-l-4 border-blue-500">

        <div class="text-xs text-gray-400">
          📥 หน้าห้อง ผกก.
        </div>

        <div id="count1"
        class="text-3xl font-bold mt-2">
          0
        </div>

      </div>

      <div class="card p-4
      border-l-4 border-green-500">

        <div class="text-xs text-gray-400">
          📤 หน้าห้อง ผบก.
        </div>

        <div id="count2"
        class="text-3xl font-bold mt-2">
          0
        </div>

      </div>

      <div class="card p-4
      border-l-4 border-red-500">

        <div class="text-xs text-gray-400">
          ❌ ตีกลับ
        </div>

        <div id="countReject"
        class="text-3xl font-bold mt-2">
          0
        </div>

      </div>

      <div class="card p-4
      border-l-4 border-yellow-500">

        <div class="text-xs text-gray-400">
          📁 ทั้งหมด
        </div>

        <div id="countTotal"
        class="text-3xl font-bold mt-2">
          0
        </div>

      </div>

    </div>

    <!-- TIMELINE -->
    <div class="card p-4 mt-5">

      <div class="flex
      justify-between
      items-center mb-4">

        <h2 class="font-bold">
          📜 Timeline ล่าสุด
        </h2>

        <input type="text"
        id="searchInput"
        placeholder="ค้นหา..."
        class="border rounded-xl
        px-3 py-2 text-sm">

      </div>

      <div id="timeline"></div>

    </div>

  </section>

  <!-- SCAN -->
  <section id="scan"
  class="tab">

    <div class="card p-4">

      <h2 class="font-bold mb-4">
        📷 สแกน QR ปกแฟ้ม
      </h2>

      <div id="reader"></div>

      <button onclick="startScanner()"
      class="mt-4 bg-[#143f24]
      text-white w-full py-3
      rounded-2xl font-bold">

        เปิดกล้องสแกน

      </button>

    </div>

  </section>

  <!-- REGISTER -->
  <section id="register"
  class="tab">

    <div class="card p-4">

      <h2 class="font-bold mb-4">
        📁 ลงทะเบียนแฟ้มใหม่
      </h2>

      <div class="space-y-4">

        <input id="folderId"
        placeholder="Folder ID"
        class="w-full border
        rounded-xl p-3">

        <input id="title"
        placeholder="ชื่อเรื่อง"
        class="w-full border
        rounded-xl p-3">

        <input id="owner"
        placeholder="เจ้าของเรื่อง"
        class="w-full border
        rounded-xl p-3">

        <!-- PRIORITY -->
        <select id="priority"
        class="w-full border
        rounded-xl p-3">

          <option>
            🔴 ด่วนที่สุด
          </option>

          <option>
            🟠 ด่วน
          </option>

          <option selected>
            🟡 ปกติ
          </option>

          <option>
            🟢 ต่ำ
          </option>

        </select>

        <!-- SECURITY -->
        <select id="security"
        class="w-full border
        rounded-xl p-3">

          <option>
            🔓 ปกติ
          </option>

          <option>
            🔒 ลับ
          </option>

          <option>
            🔐 ลับมาก
          </option>

          <option>
            ☢️ ลับที่สุด
          </option>

        </select>

        <button onclick="registerFolder()"
        class="bg-[#143f24]
        text-white w-full py-3
        rounded-2xl font-bold">

          สร้างแฟ้ม + QR

        </button>

      </div>

    </div>

    <!-- QR -->
    <div id="qrBox"
    class="card p-5 mt-5 hidden">

      <div class="text-center">

        <div class="text-xs
        text-gray-400">

          🇹🇭 กองกำกับการตำรวจ
          ตระเวนชายแดน

        </div>

        <div id="qrcode"
        class="mt-3 flex
        justify-center"></div>

        <div id="qrId"
        class="font-bold mt-3"></div>

        <div id="qrTitle"
        class="text-sm mt-2"></div>

        <button onclick="window.print()"
        class="mt-5 bg-black
        text-white px-5 py-3
        rounded-xl">

          🖨️ พิมพ์ป้ายแฟ้ม

        </button>

      </div>

    </div>

  </section>

  <!-- UPDATE -->
  <section id="update"
  class="tab">

    <div class="card p-5">

      <div class="flex
      justify-between">

        <div>

          <div id="updateId"
          class="font-bold text-lg">
          </div>

          <div id="updateTitle"
          class="text-sm text-gray-500">
          </div>

        </div>

      </div>

      <div class="mt-5 space-y-3">

        <button
        onclick="selectWorkflow(
        'PHASE_1',
        '📥 จนท.หน้าห้อง ผกก. รับเรื่อง → ผ่าน ผกก.'
        )"
        class="workflow-btn
        bg-blue-50 border
        border-blue-200">

          📥 หน้าห้อง ผกก.

        </button>

        <button
        onclick="selectWorkflow(
        'PHASE_2',
        '📤 จนท.หน้าห้อง ผบก. รับเรื่อง → ผ่าน ผบก.'
        )"
        class="workflow-btn
        bg-green-50 border
        border-green-200">

          📤 หน้าห้อง ผบก.

        </button>

        <button
        onclick="selectWorkflow(
        'REJECT',
        '❌ ตีกลับแก้ไขเอกสาร'
        )"
        class="workflow-btn
        bg-red-50 border
        border-red-200">

          ❌ ตีกลับแก้ไข

        </button>

      </div>

      <input id="reporter"
      placeholder="ยศ-ชื่อ ผู้รายงาน"
      class="w-full border
      rounded-xl p-3 mt-5">

      <textarea id="remark"
      placeholder="หมายเหตุ"
      class="w-full border
      rounded-xl p-3 mt-3">
      </textarea>

      <button onclick="submitUpdate()"
      class="bg-[#143f24]
      text-white w-full py-3
      rounded-2xl mt-5">

        🚀 อัปเดตสถานะ

      </button>

    </div>

  </section>

</main>

<!-- NAV -->
<nav class="bottom-nav
grid grid-cols-4 py-2">

  <button onclick="showTab('dashboard')">
    📊
  </button>

  <button onclick="showTab('scan')">
    📷
  </button>

  <button onclick="showTab('register')">
    📁
  </button>

  <button onclick="showTab('update')">
    📍
  </button>

</nav>

<script>

let WEBAPP =
localStorage.getItem("BPP_WEBAPP")
|| "";

let currentFolder = "";
let currentStatusCode = "";
let currentStatusTitle = "";

function showTab(id){

  document.querySelectorAll(".tab")
  .forEach(t=>t.classList.remove("active"));

  document.getElementById(id)
  .classList.add("active");
}

function registerFolder(){

  const folderId =
  document.getElementById("folderId")
  .value;

  const title =
  document.getElementById("title")
  .value;

  const owner =
  document.getElementById("owner")
  .value;

  const priority =
  document.getElementById("priority")
  .value;

  const securityLevel =
  document.getElementById("security")
  .value;

  fetch(WEBAPP,{

    method:"POST",

    headers:{
      "Content-Type":"application/json"
    },

    body:JSON.stringify({

      action:"register",

      folderId,
      title,
      owner,
      priority,
      securityLevel

    })

  })
  .then(r=>r.json())
  .then(res=>{

    if(res.success){

      createQR(folderId,title);

      alert("สร้างแฟ้มสำเร็จ");

    }else{

      alert(res.message);

    }

  });
}

function createQR(id,title){

  document.getElementById("qrBox")
  .classList.remove("hidden");

  document.getElementById("qrId")
  .innerText=id;

  document.getElementById("qrTitle")
  .innerText=title;

  document.getElementById("qrcode")
  .innerHTML="";

  const url =
  location.origin +
  location.pathname +
  "?id=" + id;

  new QRCode(
    document.getElementById("qrcode"),
    {
      text:url,
      width:180,
      height:180
    }
  );
}

function startScanner(){

  const html5QrCode =
  new Html5Qrcode("reader");

  html5QrCode.start(
    { facingMode:"environment" },
    {
      fps:15,
      qrbox:250
    },

    (decodedText)=>{

      let id = "";

      if(decodedText.includes("?id=")){

        id =
        new URL(decodedText)
        .searchParams.get("id");

      }

      openUpdate(id);

      html5QrCode.stop();

    }
  );
}

function openUpdate(id){

  currentFolder=id;

  showTab("update");

  document.getElementById("updateId")
  .innerText=id;

  fetch(
    WEBAPP +
    "?action=getFolder&folderId=" +
    id
  )
  .then(r=>r.json())
  .then(data=>{

    document.getElementById(
      "updateTitle"
    ).innerText=data.title;

  });
}

function selectWorkflow(code,title){

  currentStatusCode=code;
  currentStatusTitle=title;

  alert("เลือกสถานะแล้ว");
}

function submitUpdate(){

  const reporter =
  document.getElementById("reporter")
  .value;

  const remark =
  document.getElementById("remark")
  .value;

  fetch(WEBAPP,{

    method:"POST",

    headers:{
      "Content-Type":"application/json"
    },

    body:JSON.stringify({

      action:"updateStatus",

      folderId:currentFolder,

      statusCode:
      currentStatusCode,

      statusTitle:
      currentStatusTitle,

      officer:reporter,

      remark:remark,

      priority:"🟡 ปกติ",

      securityLevel:"🔓 ปกติ"

    })

  })
  .then(r=>r.json())
  .then(()=>{

    alert("อัปเดตสำเร็จ");

    loadTimeline();

    showTab("dashboard");

  });
}

function loadTimeline(){

  fetch(WEBAPP + "?action=getRecent")
  .then(r=>r.json())
  .then(data=>{

    let html="";

    let c1=0,c2=0,cr=0;

    data.forEach(item=>{

      if(item[3]==="PHASE_1") c1++;
      if(item[3]==="PHASE_2") c2++;
      if(item[3]==="REJECT") cr++;

      html += `
      <div class="timeline mb-5">

        <div class="font-bold">
          ${item[1]}
        </div>

        <div class="text-sm">
          ${item[2]}
        </div>

        <div class="text-xs text-gray-500 mt-1">
          ${item[4]}
        </div>

      </div>
      `;
    });

    document.getElementById("timeline")
    .innerHTML=html;

    document.getElementById("count1")
    .innerText=c1;

    document.getElementById("count2")
    .innerText=c2;

    document.getElementById("countReject")
    .innerText=cr;

    document.getElementById("countTotal")
    .innerText=data.length;

  });
}

window.onload=()=>{

  const params =
  new URLSearchParams(
    location.search
  );

  const id=params.get("id");

  if(id){

    openUpdate(id);

  }

  loadTimeline();

};

</script>

</body>
</html>
